# Copy to .env.local. Never commit real values: this repo is public.
#
# Nothing is required today. Launchpad is a static prototype: every figure comes from
# src/data/ or the in-memory store, and no code reads process.env. `npm run dev` works
# with no .env file at all.
#
# The variables below are what the backend phase will need. The names follow the original
# Launchpad build (Locale_Launchpad-main, src/lib/env.ts), so the Operations rebuild can
# reuse them (see docs/OPERATIONS-DASHBOARD.md). Uncomment each one when code first reads it.

# --- Environment --------------------------------------------------------------------------
# Selects the config rows for board and stage IDs: local | staging | production.
# LAUNCHPAD_ENV=local

# --- Supabase -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key is safe in the browser.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The service role key is server-side only. Never prefix it NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# Personal access token for scripts that call the Supabase management API.
# SUPABASE_ACCESS_TOKEN=

# --- HubSpot ------------------------------------------------------------------------------
# The private app token for this environment. Use the sandbox portal's token locally and on
# staging. The production token goes on the Vercel production target only.
HUBSPOT_TOKEN=ap1-4470-1101-4b3d-840c-7405ca0597b5

# --- Monday -------------------------------------------------------------------------------
# MONDAY_API_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJ0aWQiOjcxMTA3MjQxOCwiYWFpIjoxMSwidWlkIjoxMTgwMTE1ODMsImlhZCI6IjIwMjYtMTAtMDZUMDc6MDk6MDkuMDAwWiIsInBlciI6Im1lOndyaXRlIiwiYWN0aWQiOjI1MzczNTE4LCJyZ24iOiJhcHNlMiJ9.Q8m4q-Qd0RIj6zwdxoaDroaGCP6jkWw6i_dsLmFVb_c

# --- Write safety -------------------------------------------------------------------------
# Display only: the database decides dry run. Leave true until an environment goes live.
# OUTBOX_DRY_RUN=true
# Bearer secret for an on-demand dispatcher call. Use a long random value.
# OUTBOX_DISPATCH_SECRET=
# Vercel sends this as the bearer on scheduled cron requests.
# CRON_SECRET=

# --- Teams --------------------------------------------------------------------------------
# A Teams Workflows "post to a channel when a webhook request is received" URL, used for the
# twice-daily sync digest. Leave empty on staging: the digest goes to the audit log instead.
# TEAMS_OPS_WEBHOOK_URL=
